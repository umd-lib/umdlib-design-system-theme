{# 
/**
 * @file
 * UMD Libraries Alert component.
 *
 * Available variants:
 * - in_page
 * - site_wide
 *
 * Variables:
 * title: The title of the alert.
 * alert_description: The description text of the alert.
 * link_text: The text for the link.
 * link_url: The URL for the link.
 */
 #}

{# Get the variant, defaulting to standard if not specified #}
{% set selectedVariant = variant | default('in_page') %}

{# Single source of truth: render the image only on site-wide alerts that supply
   both the image and its alt text. #}
{% set has_image = selectedVariant == 'site_wide' and alert_image is defined and alert_image_alt is defined %}

{# missing fields #}
{% set errors = [] %}
{% if title is not defined or title is empty %}
  {% set errors = errors | merge(['Alert Title']) %}
{% endif %}
{% if selectedVariant == 'site_wide' and alert_image is defined and not has_image %}
  {% set errors = errors | merge(['Alert Image Alt Text']) %}
{% endif %}

{# component content #}
{% if errors is empty %}
{% set alertId = componentid | default('alert-' ~ random()) %}
<div 
  {% if selectedVariant == 'in_page' %}role="note" {% else %}role="region"{% endif %}
  class="umd-lib alert alert--{{ selectedVariant }} {% if selectedVariant == 'site_wide' and site_wide_alert_customization_class is defined %}{{ site_wide_alert_customization_class }}{% endif %}" 
  aria-labelledby="{{ alertId }}-title"
  id="{{ alertId }}">
  <div class="alert--container {% if selectedVariant == 'site_wide' %}s-box-page-medium-h s-center s-page-lock {% else %} s-margin-general-medium {% endif %}">
    <div class="alert--content s-box-medium-v {% if selectedVariant == 'in_page' %}s-box-medium-h{% endif %}">
      
      <div class="alert--title">
        {% if selectedVariant == 'in_page' %}
          <h{{ heading_level | default('h2') | slice(1) }} id="{{ alertId }}-title" class="t-title-small c-content-primary s-stack-small">
        {% else %}
          <p id="{{ alertId }}-title" class="t-title-small c-content-primary s-stack-small">
        {% endif %}

        {% block title %} {% endblock %}

        {% if selectedVariant == 'in_page' %}
          </h{{ heading_level | default('h2') | slice(1) }}>
        {% else %}
          </p>
        {% endif %}
      </div>
      
      {% if has_image %}
        <div class="alert--content-with-image">
         <div class="alert--content-text">
      {% endif %}
      
      {% if alert_description is defined and alert_description is not empty %}
        <div class="alert--description {% if link_text is not empty and link_url is not empty %}s-stack-medium{% endif %} wysiwyg-editor">
          {% block alert_description %} {% endblock %}
        </div>
      {% endif %}

      {% if link_text is not empty and link_url is not empty %}
        {% include 'umdlib_umdds:umd-libraries-emphasized-link' with {
          'link_text': link_text,
          'link_url': link_url,
        } only %}
      {% endif %}

      {% if has_image %}
        </div>
        <div class="alert--image">
          <img src="{{ alert_image }}" alt="{{ alert_image_alt }}" loading="lazy">
        </div>
        </div>
      {% endif %}

      {% if selectedVariant == 'site_wide' %}
        <div class="alert--button-close s-box-medium-v">
          <button class="" 
            aria-label="Close site notification" 
            aria-controls="{{ alertId }}">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3.2561" y="0.321533" width="20.75" height="4.15" transform="rotate(45 3.2561 0.321533)" fill="black"></rect><rect x="17.9285" y="3.25598" width="20.75" height="4.15" transform="rotate(135 17.9285 3.25598)" fill="black"></rect></svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% else %}
  {# variable error handling #}
  <div class="c-content-interactive-primary c-bg-interactive-primary s-box-small-h">[ERROR] - UMD Libraries Alert / Variant - {{ selectedVariant }}</div>
  <div class="s-box-small-h">Required fields missing: <strong>{{ errors|join(', ') }}</strong></div>
{% endif %}
