{# 
/**
 * @file
 * UMD Lib Navigation - Utility - Status
 *
 * Variables:
 * - title_text: Menu Title
 * - title_url: URL for the utility title link
 * - error_number: Number of errors for badge display
 * - link_text: Text for the utility link
 * - link_url: URL for the utility link
 * - status_slot: Library system status content
 */
#}

{% set title_text %}{% block title_text %}{% endblock %}{% endset %}
{% set title_text = title_text|trim ? : "System Status" %}

{% set title_url %}{% block title_url %}{% endblock %}{% endset %}
{% set title_url = title_url | trim %}

{% set error_number %}{% block error_number %}{% endblock %}{% endset %}
{% set error_number = error_number | trim %}

{% set link_text %}{% block link_text %}{% endblock %}{% endset %}
{% set link_text = link_text|trim ?: "All Status of Library Services" %}

{% set link_url %}{% block link_url %}{% endblock %}{% endset %}
{% set link_url = link_url | trim %}


<li class="umd-lib navigation__menu-item utility-content utility-status" id="{{ title_text | lower | replace({' ': '-'}) }}">
  <a href="{{ title_url }}" class="navigation__menu-link">{{ title_text }} 
    {% if error_number %}<div class="badge badge--ok t-label">{{ error_number }}</div>{% endif %}
  </a>
  <button
    class="navigation__submenu-button"
    aria-expanded="false"
    aria-controls="submenu-{{ title_text | lower | replace({' ': '-'}) }}"
    aria-label="Next level of navigation of {{ title_text }}"
  >
      <span class="i-chevron-down"></span>
  </button>
  <div class="navigation__submenu utility-status" id="submenu-{{ title_text | lower | replace({' ': '-'}) }}">
    <div class="navigation__submenu-content">
      <div class="navigation__submenu-title">
        <a href="{{ title_url }}">{{ title_text }}</a>
      </div>
      
      {% if link_url is defined and link_text is defined %}
        <ul class="navigation__submenu-list">
          <li class="navigation__submenu-item">
            <a
              href="{{ link_url }}"
              class="navigation__submenu-link ani-underline c-underline-primary t-body-small"
            >
              {{ link_text }}
            </a>
          </li>
        </ul>
      {% endif %}
      {# System Status #}
      {% block status_slot %}
        <section aria-label="Library system status as of {{ 'now'|date('F j, Y \\a\\t g:iA') }}" class="c-bg-secondary s-box-medium-v s-box-medium-h">
          <div class="t-title-small s-stack-medium" aria-hidden="true">{{ 'now'|date('F j, Y \\a\\t g:iA') }}</div>
            <ul class="navigation__utility_system-status-list">
              {# all system are operational #}
              <li class="navigation__utility_system-status-item s-stack-small">
                <div class="navigation__utility_system-status-item-status t-body-small">
                  <span class="navigation__utility_system-status-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="18" viewBox="0 0 19 18" fill="none">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M7.65 12.59L18.51 0L18.92 5.21C14.7453 10.0994 12.4047 12.8406 8.23 17.73L7.99 17.53L7.87 17.67L0 11.25L4.8 10.26L7.65 12.58V12.59Z" fill="#037623"/>
                    </svg>
                  </span>
                  All Systems are Operational
                </div>
              </li>
              {# If there are system errors, display the list of affected services. #}
              <li class="navigation__utility_system-status-item s-stack-small  t-body-small">
                <div class="navigation__utility_system-status-item-status t-body-small">
                  <span class="navigation__utility_system-status-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="4" height="17" viewBox="0 0 4 17" fill="none">
                      <path d="M3.5 0H0V11.38H3.5V0Z" fill="#E21833"/>
                      <path d="M3.5 13.38H0V16.88H3.5V13.38Z" fill="#E21833"/>
                    </svg>
                  </span>
                  Web of Science
                </div>
              </li>
              <li class="navigation__utility_system-status-item s-stack-small t-body-small">
                <div class="navigation__utility_system-status-item-status t-body-small">
                  <span class="navigation__utility_system-status-item-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="4" height="17" viewBox="0 0 4 17" fill="none">
                      <path d="M3.5 0H0V11.38H3.5V0Z" fill="#E21833"/>
                      <path d="M3.5 13.38H0V16.88H3.5V13.38Z" fill="#E21833"/>
                    </svg>
                  </span>
                  Harvard Education Review
                </div>
              </li>
            </ul>
          </div>
        </section>
      {% endblock %}
    <div class="navigation__submenu-header">
      <button class="navigation__back-button">
        <span class="i-chevron-down"></span>
        <p class="t-label ani-underline c-underline-secondary">
          Back
        </p>
      </button>
    </div>
  </div>
</li>
