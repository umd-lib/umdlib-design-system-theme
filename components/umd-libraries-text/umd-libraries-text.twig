{# 
/**
 * @file
 * UMD Libraries Body component.
 *
 * Variables:
 * body_text_slot: Slot for the main body text elements.
 * componentid: (optional) An ID to use for the component. This can be used for section referencing.
 * component_class: (optional) A CSS class to apply to the component.
 */
 #}

{% if body_text_slot is defined %}
  <div class="umd-lib body body--content wysiwyg-editor s-margin-general-medium {{ component_class | default('') }}" id="{{ componentid | default('') }}">
   {{ body_text_slot | raw }}
  </div>

{% else %}
  {# variable error handling #}
  <div class="c-content-interactive-primary c-bg-interactive-primary s-box-small-h"> [ERROR] - UMD Libraries Body</div>
  <div class="s-box-small-h"> Required fields missing: <strong>Body Text (WYSIWYG)</strong></div>
{% endif %}
